{
  "name": "world-history-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-worker.mjs && vite",
    "build": "node scripts/copy-worker.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-worker.mjs",
    "data:build": "node scripts/build-map-data.mjs",
    "data:country-index": "npx tsx scripts/build-country-index.mjs",
    "data:validate": "npx tsx scripts/validate-content.mjs",
    "media:prompts": "npx tsx scripts/export-illustration-prompts.mjs",
    "media:scripts": "npx tsx scripts/export-narration-scripts.mjs",
    "media:ticker-scripts": "npx tsx scripts/export-ticker-scripts.mjs",
    "media:import": "node scripts/import-media-pack.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "maplibre-gl": "^5.0.0 || ^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.4.0",
    "mapshaper": "^0.8.9",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
